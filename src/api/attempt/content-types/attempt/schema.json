      "target": "plugin::users-permissions.user",
      "inversedBy": "attempts"
    },
    "session": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::study-session.study-session"
    },
    "flashcard": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::flashcard.flashcard"
    },
    "userAnswer": {
      "type": "text"
    },
    "isCorrect": {
      "type": "boolean"
    },
    "attemptNumber": {
      "type": "integer"
    },
    "answeredAt": {
      "type": "datetime"
    }
  }
}
