{
  "kind": "collectionType",
  "collectionName": "attempts",
  "info": {
    "singularName": "attempt",
    "pluralName": "attempts",
    "displayName": "Attempt"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
