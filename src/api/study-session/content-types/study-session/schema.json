{
  "kind": "collectionType",
  "collectionName": "study_sessions",
  "info": {
    "singularName": "study-session",
    "pluralName": "study-sessions",
    "displayName": "StudySession"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "study_sessions"
    },
    "folder": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::study-folder.study-folder"
    },
    "totalCards": {
      "type": "integer"
    },
    "completedCards": {
      "type": "integer",
      "default": 0
    },
    "correctCount": {
      "type": "integer",
      "default": 0
    },
    "wrongCount": {
      "type": "integer",
      "default": 0
    },
    "score": {
      "type": "decimal"
    },
    "sessionStatus": {
      "type": "enumeration",
      "default": "draft",
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "completed"
      ]
    },
    "completedAt": {
      "type": "datetime"
    },
    "startedAt": {
      "type": "datetime"
    }
  }
}
